# Bloodlink - variaveis de ambiente para desenvolvimento local
# NUNCA commitar este arquivo (ja esta no .gitignore)

# --- bloodlink-centro ---

# Usado pelo JwtConfig para assinar os tokens. Troque por uma string longa e aleatoria.
BLOODLINK_JWT_SECRET=troque-esta-string-por-algo-bem-longo-e-aleatorio-para-dev

# Usados pelo PlataformaSeeder para criar o primeiro usuario PLATAFORMA no boot.
# Se deixar em branco, o seeder gera uma senha aleatoria e loga ela uma unica vez no console.
BLOODLINK_PLATAFORMA_EMAIL=admin@bloodlink.local
BLOODLINK_PLATAFORMA_SENHA=Bloodlink@Plataforma2026